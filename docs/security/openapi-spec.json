{"openapi":"3.1.0","info":{"title":"Nexus Agent API Gateway","version":"1.0.0"},"paths":{"/chat":{"post":{"summary":"Chat","description":"Proses prompt via Agentic Loop + persist pesan ke session.\n\nKEAMANAN: user dari JWT (Authorization Bearer), BUKAN dari body email.\nBila credential hilang -> HTTP 200 {status: needs_credential} (bukan 500).\n\nReturns:\n    status=success     -> {status, reply, session_id}\n    status=needs_credential -> {status, provider, message}","operationId":"chat_chat_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/me":{"get":{"summary":"Me","description":"Kembalikan {email, tier} user JWT (tier dari public.users, default free).","operationId":"me_me_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/preferences":{"get":{"summary":"Get Preferences","description":"Preferensi UI user JWT (kosong bila belum pernah disimpan).","operationId":"get_preferences_preferences_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"summary":"Put Preferences","description":"Simpan (merge) preferensi UI user JWT. Kunci yang tidak dikirim tetap utuh.","operationId":"put_preferences_preferences_put","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreferencesBody"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/quota":{"get":{"summary":"Get Quota","description":"Kuota hari ini untuk user JWT: dipakai progress bar + warning pre-flight.\n\nSatuannya **REQUEST** (1 request = 1 RPD), bukan \"chat\": satu percakapan bisa\nberisi beberapa request (agent loop), jadi menampilkan \"chat\" akan menipu.","operationId":"get_quota_quota_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/analytics":{"get":{"summary":"Get Analytics","description":"Authenticated, owner-scoped usage and workflow execution summary.","operationId":"get_analytics_analytics_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/models":{"get":{"summary":"List Models","description":"Daftar model dari DISCOVERY live (bukan hardcode) + flag locked.\n\nlocked=False -> bisa dipilih. locked=True -> redup + Upgrade link.\n`refreshed_at` menandai umur cache discovery (TTL 1 jam).","operationId":"list_models_models_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/auto-config/preview":{"post":{"summary":"Mcp Auto Config Preview","operationId":"mcp_auto_config_preview_mcp_auto_config_preview_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AutoConfigPreviewRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/my-instances":{"get":{"summary":"Mcp My Instances","operationId":"mcp_my_instances_mcp_my_instances_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/install":{"post":{"summary":"Mcp Install","operationId":"mcp_install_mcp_install_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MCPInstanceRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/uninstall/{mcp_id}":{"delete":{"summary":"Mcp Uninstall","operationId":"mcp_uninstall_mcp_uninstall__mcp_id__delete","parameters":[{"name":"mcp_id","in":"path","required":true,"schema":{"type":"string","title":"Mcp Id"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/gateway/health":{"get":{"summary":"Mcp Gateway Health","operationId":"mcp_gateway_health_mcp_gateway_health_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/gateway/servers":{"get":{"summary":"Mcp Gateway Servers","operationId":"mcp_gateway_servers_mcp_gateway_servers_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/gateway/call":{"post":{"summary":"Mcp Gateway Call","operationId":"mcp_gateway_call_mcp_gateway_call_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GatewayCallRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/recommendations":{"get":{"summary":"Mcp Recommendations","operationId":"mcp_recommendations_mcp_recommendations_get","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string","title":"Q"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":5,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry":{"get":{"summary":"Mcp Registry","description":"view=all is the raw merged catalogue; view=unique is the deduped set.\n\nBoth are real numbers and they differ by the duplicate rate, so the caller\nmust say which one it is displaying rather than being handed one by default.\n\n`tier` is passed straight through to the registry, which owns the single\ndefinition of a tier. The UI filters and badges from the same function, so\nthe two cannot disagree.","operationId":"mcp_registry_mcp_registry_get","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","default":1,"title":"Page"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}},{"name":"search","in":"query","required":false,"schema":{"type":"string","default":"","title":"Search"}},{"name":"category","in":"query","required":false,"schema":{"type":"string","default":"","title":"Category"}},{"name":"source","in":"query","required":false,"schema":{"type":"string","default":"","title":"Source"}},{"name":"view","in":"query","required":false,"schema":{"type":"string","default":"all","title":"View"}},{"name":"tier","in":"query","required":false,"schema":{"type":"string","default":"","title":"Tier"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry/capabilities":{"get":{"summary":"Mcp Registry Capabilities","description":"Apakah view `unique` benar-benar bisa dilayani, dan kenapa.\n\n`dedup_canonical.json` sengaja TIDAK di-commit (29,8 MB hasil turunan), jadi\nada deploy yang bisa booting tanpa file itu. Waktu itu `GET /mcp/registry?\nview=unique` balas 400 dan toggle \"Unique (dedup)\" di UI jadi gagal tanpa\npenjelasan.\n\nFrontend memakai endpoint ini untuk jujur menyembunyikan toggle ketika\nartifact-nya memang tidak ada, alih-alih memunculkan kontrol yang pasti\nerror. `reason` sengaja dikembalikan supaya UI bisa menjelaskan, bukan\nhanya diam.\n\nCatatan: `buildCommand: python mcp_dedup.py` di railway.json seharusnya\nselalu menghasilkan file ini, jadi di Railway normal nilainya true. Endpoint\nini adalah jaring pengaman untuk target deploy lain (Railway alternate,\ncontainer manual, Codespaces) yang tidak menjalankan build step.","operationId":"mcp_registry_capabilities_mcp_registry_capabilities_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/mcp/native":{"get":{"summary":"Mcp Native","description":"The natively executable providers, derived from provider_registry.\n\nThe count is computed from code, never hardcoded in the UI, so the\n\"Native\" marketplace tab can never drift from what actually runs.\n\n``credential`` is empty only for providers that execute without any user\nsecret; that is what separates the Ready badge from Auth required.","operationId":"mcp_native_mcp_native_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/community/submit":{"post":{"summary":"Community Submit","description":"Submit an integration manifest for review. Pending is not approved.","operationId":"community_submit_community_submit_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommunitySubmission"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/community/browse":{"get":{"summary":"Community Browse","description":"Approved submissions only - never pending or rejected ones.","operationId":"community_browse_community_browse_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":25,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/community/review":{"get":{"summary":"Community Review","description":"Queue of pending submissions for moderation.","operationId":"community_review_community_review_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/community/my-earnings":{"get":{"summary":"Community My Earnings","operationId":"community_my_earnings_community_my_earnings_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry/categories":{"get":{"summary":"Mcp Registry Categories","description":"Category facet for the F4.3 filter, derived from the same rows as the grid.","operationId":"mcp_registry_categories_mcp_registry_categories_get","parameters":[{"name":"source","in":"query","required":false,"schema":{"type":"string","default":"","title":"Source"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":40,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry/sources":{"get":{"summary":"Mcp Registry Sources","description":"Per-source counts plus the Glama credit the UI must render.\n\nGlama's API Data License requires a visible \"Powered by Glama\" credit on\nevery page that shows its data, so the API ships the exact link and label\nrather than letting the frontend invent one.","operationId":"mcp_registry_sources_mcp_registry_sources_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/mcp/registry/coverage":{"get":{"summary":"Mcp Registry Coverage","operationId":"mcp_registry_coverage_mcp_registry_coverage_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/mcp/recommended":{"get":{"summary":"Mcp Recommended","description":"Integrasi yang direkomendasikan, dihitung dari rumus yang dikunci.\n\nSkor dihitung runtime di `mcp_registry.compute_recommendation_score` â\ntidak ada daftar hardcoded di endpoint maupun di registry. Endpoint ini\nhanya membungkusnya, menambah batasan param, dan meneruskan\n`data_coverage` apa adanya supaya kelemahan data terlihat di respons,\nbukan hanya di dokumen internal.\n\n`GET /mcp/registry/{server_id:path}` ada di SEJAKHIRANYA dan memakai\npola `{...:path}`, jadi rute ini harus dideklarasikan SEBELUM-nya agar\n\"recommended\" tidak tertangkap sebagai server_id.","operationId":"mcp_recommended_mcp_recommended_get","parameters":[{"name":"category","in":"query","required":false,"schema":{"type":"string","default":"","title":"Category"}},{"name":"source","in":"query","required":false,"schema":{"type":"string","default":"","title":"Source"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":5,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry/{server_id}":{"get":{"summary":"Mcp Registry Detail","operationId":"mcp_registry_detail_mcp_registry__server_id__get","parameters":[{"name":"server_id","in":"path","required":true,"schema":{"type":"string","title":"Server Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/mcp/registry/sync":{"post":{"summary":"Mcp Registry Sync","operationId":"mcp_registry_sync_mcp_registry_sync_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/integrations":{"post":{"summary":"Save Integration","description":"Simpan token kredensial user (BYOK).","operationId":"save_integration_integrations_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/google/authorize":{"get":{"summary":"Oauth Google Authorize","description":"Redirect ke consent Google (PKCE S256, access_type=offline, prompt=consent).\n\n`mode=json` mengembalikan {\"url\": ...} alih-alih 302. KENAPA: tombol\n\"Connect\" di `/settings` memakai redirect HALAMAN PENUH (bukan popup), dan\nredirect halaman penuh TIDAK bisa membawa header Authorization. Dengan mode\nini, frontend meminta URL lewat `apiFetch` (JWT ikut di header), lalu\nmengarahkan browser ke URL itu â sehingga JWT tidak pernah masuk ke URL/log.","operationId":"oauth_google_authorize_oauth_google_authorize_get","parameters":[{"name":"redirect_base","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Redirect Base"}},{"name":"mode","in":"query","required":false,"schema":{"type":"string","default":"","title":"Mode"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/google/callback":{"get":{"summary":"Oauth Google Callback","description":"Terima `code`, tukar jadi token, simpan terenkripsi, lalu balik ke /settings.","operationId":"oauth_google_callback_oauth_google_callback_get","parameters":[{"name":"code","in":"query","required":false,"schema":{"type":"string","default":"","title":"Code"}},{"name":"state","in":"query","required":false,"schema":{"type":"string","default":"","title":"State"}},{"name":"error","in":"query","required":false,"schema":{"type":"string","default":"","title":"Error"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/google/refresh":{"post":{"summary":"Oauth Google Refresh","description":"Perbarui access_token manual (selain jalur otomatis di `access_token()`).","operationId":"oauth_google_refresh_oauth_google_refresh_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/google/status":{"get":{"summary":"Oauth Google Status","description":"Status untuk UI `/settings` â TANPA nilai token (hanya boolean/umur).","operationId":"oauth_google_status_oauth_google_status_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/google":{"delete":{"summary":"Oauth Google Disconnect","description":"Cabut koneksi Google Sheets user (hapus token dari Brankas).\n\nKEAMANAN: user diambil dari JWT â user tidak bisa memutus koneksi orang lain.\nTanpa endpoint ini tombol \"Disconnect\" di `/settings` tidak punya cara sah\nuntuk mencabut akses; user hanya bisa menimpa token.","operationId":"oauth_google_disconnect_oauth_google_delete","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/slack/authorize":{"get":{"summary":"Oauth Slack Authorize","description":"Redirect ke consent Slack (scope chat:write, channels:read, users:read).\n\n`mode=json` â {\"url\": ...} (lihat penjelasan di `/oauth/google/authorize`:\ntombol Connect memakai redirect halaman penuh, dan JWT tidak boleh masuk URL).","operationId":"oauth_slack_authorize_oauth_slack_authorize_get","parameters":[{"name":"redirect_base","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Redirect Base"}},{"name":"mode","in":"query","required":false,"schema":{"type":"string","default":"","title":"Mode"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/slack/callback":{"get":{"summary":"Oauth Slack Callback","description":"Tukar code -> bot token workspace -> simpan terenkripsi di Vault.","operationId":"oauth_slack_callback_oauth_slack_callback_get","parameters":[{"name":"code","in":"query","required":false,"schema":{"type":"string","default":"","title":"Code"}},{"name":"state","in":"query","required":false,"schema":{"type":"string","default":"","title":"State"}},{"name":"error","in":"query","required":false,"schema":{"type":"string","default":"","title":"Error"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/slack/status":{"get":{"summary":"Oauth Slack Status","description":"Status Slack: kunci ada + alur OAuth SUDAH diimplementasikan (Task 1A).\n\nDibuat menerima JWT (opsional) supaya bisa dipakai dua konteks: probe tanpa\nlogin (hanya status kunci) dan UI `/settings` (status koneksi per user).","operationId":"oauth_slack_status_oauth_slack_status_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/oauth/slack":{"delete":{"summary":"Oauth Slack Disconnect","description":"Cabut instalasi Slack user (bot token dihapus dari Brankas).\n\nKEAMANAN: user dari JWT. Bot token dihapus DARI SISI KITA; untuk mencabut di\n