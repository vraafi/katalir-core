# .env.example - DAFTAR NAMA variabel (placeholder, TANPA nilai rahasia).
# Salin ke `.env` lalu isi nilainya. `.env` TIDAK PERNAH di-commit.

# ---- Dodo Payments (billing: bayar = naik TIER + topup saldo) --------------
# Webhook signing secret (Standard Webhooks). WAJIB ada di server, kalau tidak
# setiap webhook dibalas 401 (fail-closed) -> billing tidak pernah masuk.
# Bentuk: whsec_... (jangan pernah ditulis di chat/log).
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Kunci API Dodo (dipakai untuk memanggil API Dodo dari server, mis. audit produk).
DODO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# WAJIB `live_mode` di produksi. SDK memilih host API berdasarkan nilai ini, dan
# verifikasi tanda tangan ikut bergantung padanya (temuan audit 2026-09-18).
DODO_PAYMENTS_ENVIRONMENT=live_mode
# Link checkout yang dipakai UI (harga Plus: Rp 5.000.000 / TAHUN).
DODO_CHECKOUT_URL=https://checkout.dodopayments.com/buy/xxxxxxxxxxxx

# ---- Catatan penting (jangan dihapus) ------------------------------------
# * requirements.txt memakai `dodopayments[webhooks]`; TANPA extra itu
#   `client.webhooks.unwrap` melempar dan SEMUA webhook jadi 401.
# * Tabel `payment_events` (migrations/2026_payment_events.sql) adalah kunci
#   idempotensi: Dodo punya retry + bulk replay, tanpa tabel itu saldo bisa
#   dikredit berkali-kali.
