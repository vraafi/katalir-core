# .env.production (frontend) — nilai PRODUKSI yang aman dipublikasikan.
#
# KENAPA BERKAS INI ADA (insiden 12 Okt 2026):
# `NEXT_PUBLIC_*` di-INLINE oleh Next.js saat BUILD, bukan dibaca saat runtime.
# Build produksi sebelumnya menghasilkan bundle yang menunjuk host MATI
# (Railway `web-production-dc90b.up.railway.app`), sementara CSP produksi
# hanya mengizinkan `gateway.katalir.de5.net` -> browser memblokir SEMUA
# panggilan API dan 7 dari 10 skenario pengguna gagal.
#
# Berkas ini menutup celah itu untuk build di lingkungan mana pun (termasuk CI
# yang tidak punya `.env.local`, karena `.env*.local` di-gitignore).
#
# URUTAN PRIORITAS Next.js (tinggi -> rendah):
#   .env.production.local > .env.local > .env.production > .env
# Jadi `.env.local` (dev) TETAP menang saat ada; berkas ini adalah jaring
# pengaman untuk build tanpa `.env.local`.
#
# WAJIB: origin NEXT_PUBLIC_API_URL harus ada di `connect-src` public/_headers.
# Dijaga otomatis oleh `scripts/check-api-url-csp.mjs` (gagal = build batal).
# Semua nilai di bawah bersifat PUBLIK (prefix NEXT_PUBLIC_) — tidak ada rahasia.

NEXT_PUBLIC_API_URL=https://gateway.katalir.de5.net/katalir-api

NEXT_PUBLIC_SUPABASE_URL=https://qmukkphwaajzbqjrcvaz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFtdWtrcGh3YWFqemJxanJjdmF6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1MDQxNDcsImV4cCI6MjEwNDA4MDE0N30.EI_Ec25gAkZOWjXUQi6SJLHCZv0g7O_rVz-72jZdMa8

# ---------------------------------------------------------------------------
# MODEL DEFAULT — dipilih dari BUKTI PRODUKSI, bukan tebakan (14 Okt 2026)
# ---------------------------------------------------------------------------
# BUG-05/P5-15: default lama `google/gemma-4-31b-it` sudah TIDAK ada lagi di
# roster gateway (kuota RPD-nya habis -> keluar dari roster). Akibatnya SETIAP
# pesan pengguna baru dijawab dengan spanduk "Model yang Anda pilih tidak
# tersedia" (fallback=True), karena id yang diminta tak pernah teresolusi.
#
# Nilai di bawah diambil dari probe produksi terkontrol
# (`_probe_default_model_id.py` -> docs/evidence/default-model-id-2026-10-14/):
#
#   id yang diuji                        fallback  dilayani oleh            layak?
#   google/gemini-3.5-flash-lite         TRUE      gemini-3.5-flash-lite     TIDAK
#   gemini-3.5-flash-lite                false     gemini-3.5-flash-lite     YA
#   gemini-3.1-flash-lite                TRUE      gemini-3.5-flash-lite     TIDAK
#   google/gemma-4-31b-it (default lama) TRUE      gemini-3.5-flash-lite     TIDAK
#
# PENTING — JANGAN tambahkan awalan penyedia. `google/gemini-3.5-flash-lite`
# TERLIHAT lebih konsisten dengan `google/gemma-4-31b-it`, tetapi id itu TIDAK
# ada di roster: backend menandainya `model_unavailable` dan jatuh ke fallback
# — persis bug yang sedang diperbaiki. Id Gemini di roster ini ditulis TANPA
# awalan (`gemini-3.5-flash-lite`), sama seperti `DEFAULT_MODEL_PREFERENCE`
# di api_server.py:565.
NEXT_PUBLIC_DEFAULT_MODEL_ID=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# PEMBAYARAN — DITUTUP SEMENTARA (FASE 7, "coming soon")
# ---------------------------------------------------------------------------
# Gerbang utama. Hanya nilai "true" yang membuka pembayaran; apa pun selain itu
# (termasuk tidak ada variabel) = TUTUP. Lihat src/lib/payment.ts.
NEXT_PUBLIC_PAYMENT_ENABLED=false

# URL checkout Dodo. SENGAJA DIKOMENTARI selama pembayaran ditutup, bukan hanya
# "dibiarkan tapi tidak dipakai": nilai NEXT_PUBLIC_* di-INLINE ke bundle saat
# build, jadi membiarkannya berarti URL checkout tetap ikut terkirim ke browser
# dan bisa dipakai siapa pun yang membaca bundle. Dikomentari = tidak ada di
# bundle sama sekali. Buka komentarnya bersamaan dengan
# NEXT_PUBLIC_PAYMENT_ENABLED=true.
# NEXT_PUBLIC_DODO_CHECKOUT_URL=https://checkout.dodopayments.com/buy/pdt_0NnsVLn7IzpG8Sokr3pZh?quantity=1
