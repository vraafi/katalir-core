# ===== SECRETS — JANGAN pernah di-push ke git =====
.env
.env.*
!.env.example
!.env.template
*.secret
client_secret_*.json
credentials.json
token.json
# Autonomous test credentials (scripts/autonomous_login.py). The JWT is a REAL
# user access token — tracked status would put a working credential in git.
.autonomous_jwt
.autonomous_user_id
.cf_service_token_id

# ===== E2E test artifacts (berisi token sesi — JANGAN push) =====
# Globs, bukan nama pasti: `_e2e_session.extended.json` (varian dengan `exp`
# diperpanjang) sebelumnya LOLOS dari pola nama-pasti dan berisi access_token +
# refresh_token nyata — hampir ikut ter-commit.
nexus-frontend/_e2e_session*.json
nexus-frontend/_e2e_storage*.json
nexus-frontend/test-results/
nexus-frontend/playwright-report/

# ===== Generated analysis output (regenerable, huge) =====
# `python mcp_dedup.py` rebuilds these in seconds; committing a 29 MB file that
# is pure output would bloat the repo without adding information.
dedup_canonical.json

