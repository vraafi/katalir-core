# .env.example (frontend) — NAMA variabel + placeholder, TANPA nilai rahasia.
# Next meng-INLINE `NEXT_PUBLIC_*` saat build: mengubahnya wajib build ulang.

# Backend API. Dipakai src/lib/api.ts.
# WAJIB: origin di sini HARUS ada di `connect-src` public/_headers, kalau tidak
# browser memblokir semua panggilan (insiden 12 Okt 2026 — lihat
# docs/hard-test-pengguna-2026-10-12.md). Gerbang pre-build:
# `node scripts/check-api-url-csp.mjs` akan menggagalkan build bila tidak cocok.
NEXT_PUBLIC_API_URL=https://gateway.katalir.de5.net/katalir-api

# Model default untuk chat (BUG-05). OPSIONAL — bila kosong, dipakai
# "google/gemma-4-31b-it" (id katalog yang benar, berawalan penyedia).
# Isi HARUS berupa id dari GET /models; id tanpa awalan penyedia (mis.
# "gemma-4-31b-it") tidak akan teresolusi dan memicu spanduk fallback di
# setiap pesan. Lihat src/lib/models.ts (DEFAULT_MODEL_ID).
NEXT_PUBLIC_DEFAULT_MODEL_ID=google/gemma-4-31b-it

# Supabase (Auth + DB). Anon/publishable key aman dipublikasikan, tapi tetap
# JANGAN tempel di chat/log.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Sakelar pembayaran (FASE 7). Hanya "true" yang membuka tombol bayar;
# selain itu (termasuk tidak ada) = TUTUP. Lihat src/lib/payment.ts.
NEXT_PUBLIC_PAYMENT_ENABLED=false

# Link checkout Dodo Payments untuk tombol "Upgrade ke Plus"
# (harga Plus: Rp 5.000.000 / TAHUN). Ambil dari dashboard Dodo:
# Products -> produk Plus -> Checkout Link.
# Hanya dipakai bila NEXT_PUBLIC_PAYMENT_ENABLED=true. Bila kosong, CTA diganti
# lencana "segera hadir" (bukan link palsu) — lihat
# src/components/ModelSelector.tsx (BuyPlusButton).
NEXT_PUBLIC_DODO_CHECKOUT_URL=https://checkout.dodopayments.com/buy/xxxxxxxxxxxx
